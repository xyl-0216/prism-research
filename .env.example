# 本地填写自己的 OpenAI 兼容接口凭证，不要提交 .env。
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LANGSMITH_TRACING=false
GET_API_KEYS_FROM_CONFIG=false

# PDF API retrieval: no local URA weights required. Use --pdf-backend to override.
PRISM_PDF_BACKEND=api-rerank
# Optional separate Beijing DashScope credentials; otherwise use OPENAI_* above.
PRISM_RERANK_API_KEY=
PRISM_RERANK_BASE_URL=

# Original MPMQA/URA retrieval: select PRISM_PDF_BACKEND=ura (legacy environment).
# See docs/runtime.md. No one-hot/lexical fallback is used.
PRISM_MPMQA_PYTHON=
PRISM_MPMQA_REPO=
PRISM_MPMQA_CONFIG=
PRISM_MPMQA_CHECKPOINT=
PRISM_MPMQA_DEVICE=cuda:0
PRISM_MPMQA_TIMEOUT=600
