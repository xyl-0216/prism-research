# 本地填写自己的 OpenAI 兼容接口凭证，不要提交 .env。
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LANGSMITH_TRACING=false
GET_API_KEYS_FROM_CONFIG=false

# PDF retrieval: official MPMQA/URA runtime (separate legacy Python environment).
# See docs/runtime.md. No one-hot/lexical fallback is used.
PRISM_MPMQA_PYTHON=
PRISM_MPMQA_REPO=
PRISM_MPMQA_CONFIG=
PRISM_MPMQA_CHECKPOINT=
PRISM_MPMQA_DEVICE=cuda:0
PRISM_MPMQA_TIMEOUT=600
